# NEON INVADERS server -- copy to .env and fill in real values.
# .env is gitignored. NEVER commit a real secret.
#
# NOTE: there is no JWT_SECRET / JWT_EXPIRES_IN / BCRYPT_ROUNDS any more. This
# server no longer issues tokens or stores passwords -- Firebase Auth does
# sign-in in the browser and this server only VERIFIES the resulting ID token.

# ------------------------------- Firebase --------------------------------

# REQUIRED. The Firebase project whose ID tokens this server accepts. It is
# checked as the token's `aud` and, via https://securetoken.google.com/<id>,
# its `iss`. Without it every authenticated request is rejected with 401, and
# startup is REFUSED outright when NODE_ENV=production.
# This is a public identifier, not a secret.
FIREBASE_PROJECT_ID=

# LOCAL DEVELOPMENT ONLY. Point at a running Firebase Auth emulator, e.g.
#   npx firebase-tools emulators:start --only auth --project demo-neon-invaders
#   FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Emulator ID tokens are UNSIGNED ({"alg":"none"}, empty signature) by design,
# so setting this in production would accept forged tokens. Leave it unset
# anywhere real.
FIREBASE_AUTH_EMULATOR_HOST=

# OPTIONAL. Absolute path to a Google service-account JSON key, for the
# `admin` verification mode. Only needed if the `firebase-admin` optional
# dependency is installed AND this process has no ambient credentials
# (Cloud Run / GCE supply them automatically). Without it the server falls
# back to fetching Google's public certs and verifying RS256 itself, which
# needs no credentials at all.
# THIS FILE IS A SECRET. Never commit it.
GOOGLE_APPLICATION_CREDENTIALS=

# ------------------------------ anti-cheat -------------------------------
# Plausibility bounds on score submission. NOT a replay engine -- see
# server/README.md for what these do and do not catch.

# How long an issued run token stays submittable, in ms. Default 21600000 (6h).
# Unsubmitted tokens past this are purged opportunistically.
RUN_TTL_MS=21600000

# Safety factor on the minimum-time-per-wave bound. The game's physical floor
# is 17.8s per wave (55 aliens x 0.28s fire cooldown + 2.4s wave-clear); this
# scales it down so only impossible claims are rejected. 0.5 => 8.9s per wave.
# Set to 0 to disable the time bound entirely (the rate ceiling still applies).
RUN_MIN_SECONDS_PER_WAVE_SCALE=0.5

# Maximum points per second of measured play. The game's theoretical maximum
# sustained rate is ~136/s; 200 is deliberate headroom so a legitimate
# best-ever run is never rejected.
RUN_MAX_SCORE_PER_SECOND=200

# Seconds added to the measured elapsed time before applying the ceiling, so
# very short runs are not capped absurdly tightly.
RUN_SCORE_GRACE_SECONDS=5

# ------------------------------- transport -------------------------------

# HTTP port.
PORT=3000

# Absolute or relative path to the SQLite file.
DB_PATH=./data/neon-invaders.db

# Extra CORS origins (comma separated) on top of the built-in localhost /
# capacitor:// allowlist. Example: https://game.example.com
CORS_EXTRA_ORIGINS=

# How much of the X-Forwarded-For chain to trust when deriving req.ip (which
# is what the rate limiter keys on). LEAVE UNSET unless a reverse proxy really
# is in front of this process -- otherwise a client can spoof the header and
# dodge the limiter. Accepted values:
#   1, 2, ...            number of trusted proxy hops closest to the server
#   true                 trust the whole chain (only behind a trusted network)
#   false                trust nothing (same as leaving it unset)
#   loopback             trust 127.0.0.1/8, ::1
#   10.0.0.0/8, loopback comma-separated IPs / CIDRs / subnet names
# An unparseable value now fails at startup with an explicit message.
TRUST_PROXY=

# In-memory rate limits (requests per window per IP).
RATE_LIMIT_WINDOW_MS=900000

# Run-token issuance has its OWN bucket, separate from everything else: a
# run-start flood is the cheap way to farm tokens and age them past the time
# bound, and it must not share a counter with score submission.
RATE_LIMIT_RUNSTART_MAX=60

# Set to "production" to refuse startup when FIREBASE_PROJECT_ID is missing.
NODE_ENV=development
